# ════════════════════════════════════════════════
# BraFip Monorepo — Variáveis de Ambiente (modelo)
# Copie para .env.local e preencha. NUNCA commita .env.local.
# ════════════════════════════════════════════════

# ── Sanity CMS ──────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
SANITY_API_READ_TOKEN=           # token só-leitura para fetch server-side
SANITY_STUDIO_URL=               # ex: brafip.sanity.studio

# ── Firebase (Client SDK) ───────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK ──────────────────────────
# Cole aqui o JSON inteiro da service account (uma linha, sem quebras)
# Baixar: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Resend (email transacional) ─────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=                # ex: chamada@brafip.org.br
RESEND_REPLY_TO=                  # ex: contato@brafip.org.br

# ── Google Sheets (opcional, append de inscrições) ──
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# ── App ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=              # ex: https://brafip.org.br
